[Unit]
Description=Back up wishlist SQLite database
After=wishlist.service

[Service]
Type=oneshot
User=wishlist
Group=wishlist
ExecStart=/usr/bin/python3 /usr/local/libexec/wishlist-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/wishlist/app
ReadWritePaths=/var/backups/wishlist
MemoryMax=64M
CPUQuota=25%
