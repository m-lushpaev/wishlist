[Unit]
Description=Public Go wishlist
After=network.target

[Service]
Type=simple
User=wishlist
Group=wishlist
ExecStart=/usr/local/bin/wishlist
Environment=WISHLIST_LISTEN=127.0.0.1:10087
Environment=WISHLIST_CONTENT_ROOT=/srv/wishlist/current
Environment=WISHLIST_DB=/var/lib/wishlist/app/wishlist.db
Environment=WISHLIST_PUBLIC_HOST=wish.lushpaev.ru
Environment=WISHLIST_ADMIN_HOST=wish-admin.lushpaev.ru
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/wishlist
ReadWritePaths=/var/lib/wishlist/app
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
